# Supabase / Prisma
# Porta 6543 = pgBouncer — usar em runtime (queries normais)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Porta 5432 = conexão direta — usar apenas para migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Auth JWT próprio (não usar Supabase Auth)
JWT_SECRET=troque-por-uma-string-secreta-longa
JWT_REFRESH_SECRET=troque-por-outra-string-secreta-longa-diferente
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Servidor
PORT=3333
NODE_ENV=development
# Só em produção: libera a exclusão DEFINITIVA de usuário (limpar contas de teste antes do lançamento).
# Deixe desligado quando houver usuários reais — apaga pedidos, pagamentos e auditoria.
# ALLOW_USER_DELETION=true

# Cloudinary (necessário na Fase 2 — uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AbacatePay API v2 (pagamentos). Sem ABACATEPAY_API_KEY o sistema roda em modo
# demonstração: a cobrança é simulada e confirma na hora.
#
# Chave "abc_dev_..." = sandbox (simula transações); a de produção processa dinheiro de verdade.
# Permissões da chave (não dá para editar depois de criada): SUBSCRIPTION:CREATE|READ|DELETE,
# CHECKOUT:CREATE|READ, TRANSPARENT:CREATE|READ (PIX dos pedidos), REFUND:CREATE,
# PRODUCT:READ, CUSTOMER:CREATE|READ. NÃO dê WITHDRAW:* nem BANK_STATEMENT:READ.
ABACATEPAY_API_KEY=
# Id do produto "CutMakers Premium" (R$ 39,90, ciclo MONTHLY) criado no painel
ABACATEPAY_PREMIUM_PRODUCT_ID=
# Segredo que VOCÊ escolhe ao registrar o webhook; o gateway o devolve em ?webhookSecret=
# e é a prova de origem. Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ABACATEPAY_WEBHOOK_SECRET=
# Opcional: chave pública do AbacatePay para validar o HMAC (X-Webhook-Signature) do corpo.
# Reforça a integridade; sem ela vale só o segredo da URL.
ABACATEPAY_WEBHOOK_PUBLIC_KEY=

# URL do frontend (usada para gerar returnUrl no Abacatepay)
FRONTEND_URL=http://localhost:5173

# ─── Banco de TESTE (testes de integração) ────────────────────────────────────
# Os testes de integração criam e apagam dados. Eles NUNCA devem apontar para o
# mesmo schema da aplicação: um `deleteMany` de limpeza apagaria dados reais.
#
# Isolamento sem precisar de outro banco: o Postgres suporta múltiplos schemas na
# mesma instância, e o Prisma aceita `?schema=`. Aponte para o MESMO projeto
# Supabase, mas num schema próprio — a aplicação vive em `public` e nada do teste
# o alcança. Para derrubar tudo depois: DROP SCHEMA cutmakers_test CASCADE.
#
# Use a porta 5432 (conexão direta), NÃO a 6543: o pgBouncer opera em modo
# transaction e quebra prepared statements e o advisory lock de migration.
#
# Criar o schema e aplicar as migrations nele:
#   $env:TEST_DATABASE_URL="...?schema=cutmakers_test"
#   pnpm --filter @cutmakers/api exec prisma migrate deploy
TEST_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?schema=cutmakers_test"


# ── Segurança de autenticação ────────────────────────────────────────────────
# Atrás de proxy reverso (Caddy), informe quantos proxies ficam na frente (normalmente 1).
# SEM isto o rate limit enxerga só o IP do proxy e um atacante bloqueia TODOS os usuários.
# Em dev deixe vazio (evita forjar IP via X-Forwarded-For).
# TRUST_PROXY=1
# Desliga o rate limit (só para scripts de trace/teste local — NUNCA em produção)
# RATE_LIMIT_DISABLED=true
# Em produção a API NÃO sobe se JWT_SECRET/JWT_REFRESH_SECRET forem ausentes, iguais ou
# placeholder. Gere cada um com:  openssl rand -base64 48
