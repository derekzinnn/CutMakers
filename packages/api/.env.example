# Supabase / Prisma
# Porta 6543 = pgBouncer — usar em runtime (queries normais)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Porta 5432 = conexão direta — usar apenas para migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Auth JWT próprio (não usar Supabase Auth)
JWT_SECRET=troque-por-uma-string-secreta-longa
JWT_REFRESH_SECRET=troque-por-outra-string-secreta-longa-diferente
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Servidor
PORT=3333
NODE_ENV=development

# Cloudinary (necessário na Fase 2 — uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Abacatepay (necessário na Fase 3 — pagamentos)
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=

# URL do frontend (usada para gerar returnUrl no Abacatepay)
FRONTEND_URL=http://localhost:5173

# ─── Banco de TESTE (testes de integração) ────────────────────────────────────
# Os testes de integração criam e apagam dados. Eles NUNCA devem apontar para o
# mesmo schema da aplicação: um `deleteMany` de limpeza apagaria dados reais.
#
# Isolamento sem precisar de outro banco: o Postgres suporta múltiplos schemas na
# mesma instância, e o Prisma aceita `?schema=`. Aponte para o MESMO projeto
# Supabase, mas num schema próprio — a aplicação vive em `public` e nada do teste
# o alcança. Para derrubar tudo depois: DROP SCHEMA cutmakers_test CASCADE.
#
# Use a porta 5432 (conexão direta), NÃO a 6543: o pgBouncer opera em modo
# transaction e quebra prepared statements e o advisory lock de migration.
#
# Criar o schema e aplicar as migrations nele:
#   $env:TEST_DATABASE_URL="...?schema=cutmakers_test"
#   pnpm --filter @cutmakers/api exec prisma migrate deploy
TEST_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?schema=cutmakers_test"

