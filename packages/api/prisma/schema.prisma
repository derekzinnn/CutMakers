generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CREATOR
  EDITOR
  BOTH
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  NEGOTIATING
  AWAITING_PAYMENT
  IN_PROGRESS
  DELIVERED
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
}

enum TransactionStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum RevisionStatus {
  PENDING
  ADDRESSED
}

enum DisputeStatus {
  OPEN
  RESOLVED_RELEASED
  RESOLVED_REFUNDED
}

enum NotificationType {
  NEW_ORDER
  NEW_MESSAGE
  DELIVERY_RECEIVED
  REVISION_REQUESTED
  PAYMENT_RELEASED
  ORDER_ACCEPTED
  ORDER_CANCELLED
  PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  PAYMENT_CONFIRMED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  CONTRACT_ACCEPTED
  REQUEST_PROPOSAL_RECEIVED
  REQUEST_PROPOSAL_ACCEPTED
  REQUEST_PROPOSAL_REJECTED
}

enum RequestStatus {
  OPEN
  FILLED
  CANCELLED
}

enum RequestProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  // Nullable: contas criadas por login com Google nao tem senha local
  passwordHash    String?
  role            Role      @default(CREATOR)
  // Preenchido quando a conta foi criada/vinculada via Google (sub do Google)
  googleId        String?   @unique
  avatarUrl       String?
  bio             String?
  banned          Boolean   @default(false)
  // Aceite dos Termos de Uso da plataforma no cadastro
  termsAcceptedAt DateTime?
  // Persona do admin: usuário REAL (criador ou editor) que pertence a uma conta ADMIN. Existe para o admin
  // testar/demonstrar o produto com criador e editor DISTINTOS (auto-proposta quebraria contrato e escrow).
  // Sem senha: só é alcançada pelo endpoint de personas do admin.
  personaOfId     String?
  personaOf       User?     @relation("AdminPersonas", fields: [personaOfId], references: [id], onDelete: SetNull)
  personas        User[]    @relation("AdminPersonas")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([personaOfId, role])

  editorProfile          EditorProfile?
  favorites              Favorite[]        @relation("CreatorFavorites")
  ordersAsCreator        Order[]           @relation("CreatorOrders")
  ordersAsEditor         Order[]           @relation("EditorOrders")
  sentMessages           Message[]
  conversationsAsCreator Conversation[]    @relation("ConversationCreator")
  conversationsAsEditor  Conversation[]    @relation("ConversationEditor")
  reviewsGiven           Review[]          @relation("ReviewerUser")
  reviewsReceived        Review[]          @relation("RevieweeUser")
  notifications          Notification[]
  revisionsRequested     Revision[]
  transactionsAsPayer    Transaction[]     @relation("Payer")
  transactionsAsPayee    Transaction[]     @relation("Payee")
  proposals              OrderProposal[]
  disputesOpened         Dispute[]         @relation("DisputeOpener")
  disputesResolved       Dispute[]         @relation("DisputeResolver")
  auditLogs              AuditLog[]
  projectRequests        ProjectRequest[]
  requestProposals       RequestProposal[]
}

model EditorProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  isPremium        Boolean   @default(false)
  premiumExpiresAt DateTime?
  // Selo "verificado" CURADO pelo admin — nao e automatico. Sinal de confianca
  // para quem contrata: a CutMakers conferiu este editor.
  verified         Boolean   @default(false)
  avgRating        Float     @default(0)
  // Faixa de meia estrela derivada de avgRating (ver lib/plans.ratingBandOf).
  // Existe como coluna porque a ordenacao da busca precisa dela: o Premium
  // desempata DENTRO da faixa em vez de atropelar a qualidade. Mantida pelo
  // review.service junto com avgRating.
  ratingBand       Float     @default(0)
  totalJobs        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  categories     EditorCategory[]
  portfolioItems PortfolioItem[]
  subscriptions  Subscription[]
  favoritedBy    Favorite[]

  // Ordenacao da busca publica de editores
  @@index([ratingBand, isPremium, avgRating])
}

model Favorite {
  id              String        @id @default(uuid())
  // Quem favoritou (sempre um criador)
  userId          String
  user            User          @relation("CreatorFavorites", fields: [userId], references: [id])
  editorProfileId String
  editorProfile   EditorProfile @relation(fields: [editorProfileId], references: [id])
  createdAt       DateTime      @default(now())

  // Um criador favorita um editor no maximo uma vez
  @@unique([userId, editorProfileId])
  // Listagem "meus favoritos", mais recentes primeiro
  @@index([userId, createdAt])
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  editorCategories EditorCategory[]
  portfolioItems   PortfolioItem[]
  orders           Order[]
  projectRequests  ProjectRequest[]
}

model EditorCategory {
  editorProfileId String
  categoryId      String
  editorProfile   EditorProfile @relation(fields: [editorProfileId], references: [id])
  category        Category      @relation(fields: [categoryId], references: [id])

  @@id([editorProfileId, categoryId])
}

model PortfolioItem {
  id              String        @id @default(uuid())
  editorProfileId String
  editorProfile   EditorProfile @relation(fields: [editorProfileId], references: [id])
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  title           String
  videoUrl        String
  thumbnailUrl    String?
  basePrice       Decimal       @db.Decimal(10, 2)
  description     String?
  createdAt       DateTime      @default(now())

  orders Order[]
}

model Order {
  id                String          @id @default(uuid())
  creatorId         String
  creator           User            @relation("CreatorOrders", fields: [creatorId], references: [id])
  editorId          String
  editor            User            @relation("EditorOrders", fields: [editorId], references: [id])
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  portfolioItemId   String?
  portfolioItem     PortfolioItem?  @relation(fields: [portfolioItemId], references: [id])
  title             String
  description       String
  budget            Decimal         @db.Decimal(10, 2)
  platformFee       Decimal         @db.Decimal(10, 2)
  status            OrderStatus     @default(PENDING)
  deadline          DateTime?
  // Rodadas de revisão inclusas no contrato (cláusula 3b). Vem da solicitação no fluxo invertido.
  revisionsIncluded Int             @default(2)
  // Preenchido só quando o pedido nasceu de uma ProjectRequest (marketplace invertido)
  requestId         String?         @unique
  request           ProjectRequest? @relation(fields: [requestId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  files         OrderFile[]
  deliveries    Delivery[]
  revisions     Revision[]
  transaction   Transaction?
  conversation  Conversation?
  review        Review?
  notifications Notification[]
  proposals     OrderProposal[]
  dispute       Dispute?
  agreement     OrderAgreement?

  // Dashboards do criador e do editor: where <parte> [+ status] order by createdAt desc
  @@index([creatorId, createdAt])
  @@index([editorId, createdAt])
  // Lista de ordens do admin: where status order by createdAt desc
  @@index([status, createdAt])
  // Varredura de auto-aprovacao: where status DELIVERED + updatedAt < cutoff
  @@index([status, updatedAt])
}

model OrderFile {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  fileUrl    String
  fileName   String
  fileType   String
  uploadedAt DateTime @default(now())

  @@index([orderId])
}

model Delivery {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  videoUrl  String
  message   String?
  version   Int      @default(1)
  createdAt DateTime @default(now())

  revisions Revision[]

  // Duas entregas nunca compartilham a mesma versao no mesmo pedido. O calculo
  // version = count + 1 corria solto; esta constraint e que torna impossivel
  // gravar v2 duas vezes (o service faz retry quando a corrida acontece).
  @@unique([orderId, version])
}

model Revision {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  deliveryId    String
  delivery      Delivery       @relation(fields: [deliveryId], references: [id])
  requestedById String
  requestedBy   User           @relation(fields: [requestedById], references: [id])
  description   String
  status        RevisionStatus @default(PENDING)
  createdAt     DateTime       @default(now())

  @@index([orderId, createdAt])
  // Nova entrega marca as pendentes como ADDRESSED
  @@index([orderId, status])
}

model Transaction {
  id                String            @id @default(uuid())
  orderId           String            @unique
  order             Order             @relation(fields: [orderId], references: [id])
  payerId           String
  payer             User              @relation("Payer", fields: [payerId], references: [id])
  payeeId           String
  payee             User              @relation("Payee", fields: [payeeId], references: [id])
  amount            Decimal           @db.Decimal(10, 2)
  platformFee       Decimal           @db.Decimal(10, 2)
  netAmount         Decimal           @db.Decimal(10, 2)
  status            TransactionStatus @default(PENDING)
  externalPaymentId String?
  // PIX em aberto (brCode + QR) — guardado para o criador REABRIR a cobranca. A v2 do
  // gateway nao tem pagina hospedada para o PIX transparente: o QR e mostrado por nos
  pixCode           String?
  pixQrCode         String?
  chargeExpiresAt   DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Aba Pagamentos do criador: where payerId order by createdAt desc
  @@index([payerId, createdAt])
  @@index([payeeId, createdAt])
  // Resumo financeiro do admin: agregacoes por status
  @@index([status])
  // Webhook resolve a cobranca pelo id do gateway
  @@index([externalPaymentId])
}

model Subscription {
  id                     String             @id @default(uuid())
  editorProfileId        String
  editorProfile          EditorProfile      @relation(fields: [editorProfileId], references: [id])
  status                 SubscriptionStatus @default(PENDING)
  amount                 Decimal            @db.Decimal(10, 2)
  startedAt              DateTime           @default(now())
  expiresAt              DateTime?
  externalSubscriptionId String?
  // Id da assinatura recorrente no gateway (subs_...), distinto do checkout (bill_...)
  gatewaySubscriptionId  String?
  // true = criada pelo checkout de assinatura do gateway, que RENOVA SOZINHO todo ciclo.
  // Nessas a renovacao manual e barrada (criaria uma 2a assinatura e cobraria em dobro).
  // As antigas (PIX unico) e as de demonstracao ficam false e renovam manualmente.
  recurring              Boolean            @default(false)
  // Dados da cobranca em aberto — guardados para o editor REABRIR a cobranca
  // (ver o mesmo PIX de novo) em vez de ser bloqueado ate ela expirar
  paymentUrl             String?
  pixCode                String?
  pixQrCode              String?
  chargeExpiresAt        DateTime?

  @@index([editorProfileId, status])
  // Expiracao varre as ativas vencidas
  @@index([status, expiresAt])
  // Webhook de assinatura resolve pelo id do gateway
  @@index([externalSubscriptionId])
  @@index([gatewaySubscriptionId])
}

model Conversation {
  id        String   @id @default(uuid())
  creatorId String
  creator   User     @relation("ConversationCreator", fields: [creatorId], references: [id])
  editorId  String
  editor    User     @relation("ConversationEditor", fields: [editorId], references: [id])
  orderId   String?  @unique
  order     Order?   @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())

  messages Message[]

  // listForUser: where creatorId OR editorId (o Postgres combina os dois indices)
  @@index([creatorId, createdAt])
  @@index([editorId, createdAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  // Paginacao do chat: where conversationId order by createdAt asc
  @@index([conversationId, createdAt])
}

model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  reviewerId String
  reviewer   User     @relation("ReviewerUser", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("RevieweeUser", fields: [revieweeId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  // Avaliacoes do perfil publico + recalculo de avgRating
  @@index([revieweeId, createdAt])
}

model Notification {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  type             NotificationType
  title            String
  body             String
  readAt           DateTime?
  relatedOrderId   String?
  relatedOrder     Order?           @relation(fields: [relatedOrderId], references: [id])
  // Notificações do marketplace invertido apontam para a solicitação
  relatedRequestId String?
  relatedRequest   ProjectRequest?  @relation(fields: [relatedRequestId], references: [id])
  createdAt        DateTime         @default(now())

  // O sino faz polling a cada 20s por sessao aberta: sem estes indices cada
  // tick era um full scan. Os dois mais quentes do schema.
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model OrderProposal {
  id         String         @id @default(uuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id])
  proposedBy String
  user       User           @relation(fields: [proposedBy], references: [id])
  amount     Decimal        @db.Decimal(10, 2)
  message    String?
  status     ProposalStatus @default(PENDING)
  createdAt  DateTime       @default(now())

  @@index([orderId, createdAt])
  // Guard de "1 proposta PENDING por pedido"
  @@index([orderId, status])
}

// ─── Marketplace invertido ─────────────────────────────────────────────────────
// O creator publica uma solicitação aberta; editores competem com propostas.
// O Order só é criado no aceite de uma proposta — já com editor definido —, então
// Order.editorId continua obrigatório (a fase sem editor vive inteira aqui).
model ProjectRequest {
  id                String        @id @default(uuid())
  creatorId         String
  creator           User          @relation(fields: [creatorId], references: [id])
  categoryId        String
  category          Category      @relation(fields: [categoryId], references: [id])
  title             String
  description       String
  budgetMin         Decimal?      @db.Decimal(10, 2)
  budgetMax         Decimal?      @db.Decimal(10, 2)
  deadline          DateTime?
  revisionsIncluded Int           @default(2)
  referenceLinks    String[]      @default([])
  status            RequestStatus @default(OPEN)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  proposals     RequestProposal[]
  order         Order?
  notifications Notification[]

  @@index([status, categoryId])
  @@index([creatorId])
}

model RequestProposal {
  id           String                @id @default(uuid())
  requestId    String
  request      ProjectRequest        @relation(fields: [requestId], references: [id])
  editorId     String
  editor       User                  @relation(fields: [editorId], references: [id])
  amount       Decimal               @db.Decimal(10, 2)
  deliveryDays Int
  message      String
  status       RequestProposalStatus @default(PENDING)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([requestId, editorId])
  @@index([editorId])
}

// Trilha de auditoria — registra pagamentos, disputas, mudanças de status e ações
// administrativas. actorId null = evento de sistema (webhook, auto-aprovação).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
}

// Contrato do pedido — snapshot imutável dos termos gerados no aceite da proposta.
// Ambas as partes precisam aceitar antes do pagamento (gate no payment.service).
model OrderAgreement {
  id                String    @id @default(uuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id])
  termsVersion      String
  content           String
  creatorAcceptedAt DateTime?
  editorAcceptedAt  DateTime?
  createdAt         DateTime  @default(now())
}

model Dispute {
  id           String        @id @default(uuid())
  orderId      String        @unique
  order        Order         @relation(fields: [orderId], references: [id])
  openedById   String
  openedBy     User          @relation("DisputeOpener", fields: [openedById], references: [id])
  reason       String
  resolution   String?
  resolvedById String?
  resolvedBy   User?         @relation("DisputeResolver", fields: [resolvedById], references: [id])
  status       DisputeStatus @default(OPEN)
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?

  // Fila de disputas do admin: where status OPEN order by createdAt asc
  @@index([status, createdAt])
}
