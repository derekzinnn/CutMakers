{
  "name": "cutmakers",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "api": "pnpm --filter @cutmakers/api dev",
    "web": "pnpm --filter @cutmakers/web dev"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "follow-redirects": "^1.16.2",
      "body-parser@1": "^1.20.9"
    }
  }
}
